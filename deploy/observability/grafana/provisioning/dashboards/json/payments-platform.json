{
  "uid": "payments-platform",
  "title": "Payments platform",
  "tags": ["payments"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP latency p95",
      "description": "histogram_quantile of http.server.requests. Actuator scrapes are left out so the series is the API.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP status rate",
      "description": "Requests per second by status code, excluding actuator.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox pending",
      "description": "Unpublished outbox_events rows, including rows the relay has leased.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(payments_outbox_pending)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox lag",
      "description": "Age of the oldest unpublished occurred_at.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(payments_outbox_lag_seconds)",
          "legendFormat": "oldest unpublished"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth and DLQ",
      "description": "Ready messages on payments.created.notifications (main) and its DLQ.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (role) (payments_queue_messages)",
          "legendFormat": "{{role}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hit and miss",
      "description": "Cache-aside outcomes per second. Errors are a separate counter and are not drawn here.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(payments_cache_hits_total[5m]))",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "expr": "sum(rate(payments_cache_misses_total[5m]))",
          "legendFormat": "misses"
        }
      ]
    }
  ]
}

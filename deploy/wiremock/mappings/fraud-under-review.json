{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/screenings",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$..[?(@.amount >= 5000)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "outcome": "UNDER_REVIEW",
      "reason": "Transaction flagged for manual fraud review: high amount transaction"
    }
  }
}

package com.muse.payments.__PKG__;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.muse.payments.TestcontainersBase;
import com.muse.payments.identity.application.AuthTokensResponse;
import com.muse.payments.identity.application.LoginRequest;
import com.muse.payments.identity.application.RegisterRequest;
import com.muse.payments.__PKG__.application.Create__Entity__Request;
import com.muse.payments.__PKG__.application.Update__Entity__Request;
import com.muse.payments.shared.infrastructure.OutboxRelayService;
import org.awaitility.Awaitility;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;

import java.time.Duration;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.MOCK)
@AutoConfigureMockMvc
class __Entities__IT extends TestcontainersBase {

    private static final String BASE = "/api/v1/__PATH__";
    private static final String PASSWORD = "SecurePassword123!";
    // A module-specific client keeps authentication fixtures out of other tests' Redis bucket.
    private static final String CLIENT_IP = "198.18." + (("__PKG__".hashCode() >>> 8) & 255)
            + "." + ("__PKG__".hashCode() & 255);

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @Autowired
    private JdbcTemplate jdbcTemplate;

    @Autowired
    private OutboxRelayService outboxRelayService;

    @Test
    @DisplayName("__Label__ CRUD: auth, validation, ownership, optimistic version, delete, and routable outbox events")
    void full__Entity__Lifecycle() throws Exception {
        String ownerToken = registerAndLogin("__PKG___owner_" + UUID.randomUUID() + "@example.com");
        String otherToken = registerAndLogin("__PKG___other_" + UUID.randomUUID() + "@example.com");

        // 1. No bearer token -> 401 problem+json
        mockMvc.perform(get(BASE))
                .andExpect(status().isUnauthorized())
                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
                .andExpect(jsonPath("$.title").value("Unauthorized"));

        // 2. Bean validation -> 400 with invalidParams
        mockMvc.perform(post(BASE)
                        .header("Authorization", "Bearer " + ownerToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new Create__Entity__Request(" ", null))))
                .andExpect(status().isBadRequest())
                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
                .andExpect(jsonPath("$.title").value("Validation Error"))
                .andExpect(jsonPath("$.invalidParams.name").isArray());

        // 3. Create -> 201 with Location, owner, and version 0
        MvcResult createResult = mockMvc.perform(post(BASE)
                        .header("Authorization", "Bearer " + ownerToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new Create__Entity__Request("First", "Initial"))))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.id").isNotEmpty())
                .andExpect(jsonPath("$.name").value("First"))
                .andExpect(jsonPath("$.description").value("Initial"))
                .andExpect(jsonPath("$.version").value(0))
                .andReturn();
        JsonNode created = objectMapper.readTree(createResult.getResponse().getContentAsString());
        String id = created.get("id").asText();
        assertThat(createResult.getResponse().getHeader("Location")).isEqualTo(BASE + "/" + id);

        // 4. The create transaction wrote exactly one outbox row for the aggregate
        assertThat(outboxCount(id, "__Entity__Created")).isEqualTo(1);

        // 5. Owner reads it back with the same timestamps; another user gets 404
        mockMvc.perform(get(BASE + "/" + id).header("Authorization", "Bearer " + ownerToken))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(id))
                .andExpect(jsonPath("$.createdAt").value(created.get("createdAt").asText()))
                .andExpect(jsonPath("$.version").value(0));
        mockMvc.perform(get(BASE + "/" + id).header("Authorization", "Bearer " + otherToken))
                .andExpect(status().isNotFound())
                .andExpect(jsonPath("$.title").value("Resource Not Found"));

        // 6. Owner-scoped list and paging validation
        mockMvc.perform(get(BASE).header("Authorization", "Bearer " + ownerToken))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.items.length()").value(1))
                .andExpect(jsonPath("$.items[0].id").value(id))
                .andExpect(jsonPath("$.totalElements").value(1))
                .andExpect(jsonPath("$.sort").value("createdAt,desc"));
        mockMvc.perform(get(BASE).header("Authorization", "Bearer " + otherToken))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.items.length()").value(0));
        mockMvc.perform(get(BASE).param("size", "101").header("Authorization", "Bearer " + ownerToken))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.detail").value("size must be between 1 and 100"));

        // 7. Update: stale version -> 409, another user -> 404, current version -> 200 and version 1
        mockMvc.perform(put(BASE + "/" + id)
                        .header("Authorization", "Bearer " + ownerToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new Update__Entity__Request("Second", null, 5L))))
                .andExpect(status().isConflict())
                .andExpect(jsonPath("$.title").value("Conflict"));
        mockMvc.perform(put(BASE + "/" + id)
                        .header("Authorization", "Bearer " + otherToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new Update__Entity__Request("Second", null, 0L))))
                .andExpect(status().isNotFound());
        mockMvc.perform(put(BASE + "/" + id)
                        .header("Authorization", "Bearer " + ownerToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new Update__Entity__Request("Second", "Changed", 0L))))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("Second"))
                .andExpect(jsonPath("$.description").value("Changed"))
                .andExpect(jsonPath("$.version").value(1));
        assertThat(outboxCount(id, "__Entity__Updated")).isEqualTo(1);

        // 8. Delete: another user -> 404, owner -> 204 with no body, then the row is gone
        mockMvc.perform(delete(BASE + "/" + id).header("Authorization", "Bearer " + otherToken))
                .andExpect(status().isNotFound());
        mockMvc.perform(delete(BASE + "/" + id).header("Authorization", "Bearer " + ownerToken))
                .andExpect(status().isNoContent())
                .andExpect(content().string(""));
        mockMvc.perform(get(BASE + "/" + id).header("Authorization", "Bearer " + ownerToken))
                .andExpect(status().isNotFound());
        assertThat(outboxCount(id, "__Entity__Deleted")).isEqualTo(1);

        // 9. The relay publishes all three events. An event type without a routing key and a bound
        // queue would be returned by the broker and stay unpublished with attempts > 0.
        Awaitility.await().atMost(Duration.ofSeconds(20)).pollInterval(Duration.ofMillis(200)).untilAsserted(() -> {
            outboxRelayService.relayPendingEvents();
            Integer unpublished = jdbcTemplate.queryForObject(
                    "SELECT COUNT(*) FROM outbox_events WHERE aggregate_id = ? AND published_at IS NULL",
                    Integer.class,
                    UUID.fromString(id)
            );
            assertThat(unpublished).isZero();
        });
        Integer failedAttempts = jdbcTemplate.queryForObject(
                "SELECT COALESCE(SUM(attempts), 0) FROM outbox_events WHERE aggregate_id = ?",
                Integer.class,
                UUID.fromString(id)
        );
        assertThat(failedAttempts).isZero();
    }

    private int outboxCount(String aggregateId, String eventType) {
        Integer count = jdbcTemplate.queryForObject(
                "SELECT COUNT(*) FROM outbox_events WHERE aggregate_id = ? AND event_type = ?",
                Integer.class,
                UUID.fromString(aggregateId),
                eventType
        );
        return count == null ? 0 : count;
    }

    private String registerAndLogin(String email) throws Exception {
        mockMvc.perform(post("/api/v1/auth/register")
                        .with(request -> { request.setRemoteAddr(CLIENT_IP); return request; })
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new RegisterRequest(email, PASSWORD, "__Label__ Test User"))))
                .andExpect(status().isCreated());

        MvcResult login = mockMvc.perform(post("/api/v1/auth/login")
                        .with(request -> { request.setRemoteAddr(CLIENT_IP); return request; })
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(new LoginRequest(email, PASSWORD))))
                .andExpect(status().isOk())
                .andReturn();
        return objectMapper.readValue(login.getResponse().getContentAsString(), AuthTokensResponse.class).accessToken();
    }
}

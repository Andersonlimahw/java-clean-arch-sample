package com.muse.payments.__PKG__.application;

import com.muse.payments.__PKG__.domain.__Entity__;
import com.muse.payments.__PKG__.domain.__Entity__Repository;
import com.muse.payments.shared.application.CommandHandler;
import com.muse.payments.shared.application.OutboxPort;
import com.muse.payments.shared.domain.EntityNotFoundException;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Objects;

@Service
public class Delete__Entity__CommandHandler implements CommandHandler<Delete__Entity__Command, Void> {

    private final __Entity__Repository __entity__Repository;
    private final OutboxPort outboxPort;

    public Delete__Entity__CommandHandler(__Entity__Repository __entity__Repository, OutboxPort outboxPort) {
        this.__entity__Repository = Objects.requireNonNull(__entity__Repository);
        this.outboxPort = Objects.requireNonNull(outboxPort);
    }

    @Override
    @Transactional
    public Void handle(Delete__Entity__Command command) {
        Objects.requireNonNull(command, "command must not be null");

        __Entity__ __entity__ = __entity__Repository.findById(command.__entity__Id())
                .filter(found -> found.isOwnedBy(command.userId()))
                .orElseThrow(() -> new EntityNotFoundException("__Label__ not found with id: " + command.__entity__Id()));

        __entity__.markDeleted();
        __entity__Repository.delete(__entity__);
        __Entity__OutboxMapper.appendAll(outboxPort, __entity__.pullDomainEvents());
        return null;
    }
}

package com.muse.payments.__PKG__.application;

import java.util.List;

/**
 * Same page contract as the payment lists. Each module owns its copy because the payments
 * application package is not a published module API.
 */
public record PageResponse<T>(
        List<T> items,
        int page,
        int size,
        long totalElements,
        int totalPages,
        String sort
) {

    public static <T> PageResponse<T> of(List<T> items, int page, int size, long totalElements, String sort) {
        int totalPages = size <= 0 ? 0 : (int) Math.ceil((double) totalElements / (double) size);
        return new PageResponse<>(items, page, size, totalElements, totalPages, sort);
    }
}

# Payments Platform Environment Configuration (Example for Local Dev)

# Application profile
SPRING_PROFILES_ACTIVE=local
PORT=8080

# PostgreSQL
DB_NAME=payments
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/payments

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Fraud screening. Local WireMock (docker compose service fraud-screening) answers CLEAR.
# Production must set an https URL. There is no default on the prod profile.
FRAUD_SCREENING_BASE_URL=http://localhost:8090

# Security
BCRYPT_COST=10
PASSWORD_HASHING_THREADS=0

# JWT RS256 (Leave blank in local to use auto-generated ephemeral key pair, or generate with scripts/generate-jwt-keys.sh)
JWT_ISSUER=https://api.payments.muse.com
JWT_AUDIENCE=payments-api
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# LGPD crypto-shredding KEK (ADR 0020). Blank in local = ephemeral key per run, so personal data
# written before a restart reads as [REDACTED_LGPD]. To keep it: LGPD_KEK_BASE64=$(openssl rand -base64 32)
# Required on the prod profile. Never commit a value.
LGPD_KEK_BASE64=
LGPD_KEK_ID=lgpd-kek-v1

# Optional prebuilt container image for `docker compose up -d --no-build`
# PAYMENTS_IMAGE=docker.io/<user>/payments-platform:0.1.0

# Optional JWT key rotation & TLS overrides
JWT_KEY_ID=payments-jwt-key-v1
JWT_PREVIOUS_KEY_ID=payments-jwt-key-v0
JWT_PREVIOUS_PUBLIC_KEY=
REDIS_SSL_ENABLED=false
RABBITMQ_SSL_ENABLED=false
